# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# JWT Configuration
# CRITICAL: Generate a strong random 64-byte hex secret for production:
# python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=YOUR_GENERATED_JWT_SECRET_KEY_HERE

# Firebase Firestore & Web Client Credentials
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=presenova-fyp
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Groq API Configuration (for Whisper Speech-to-Text)
GROQ_API_KEY=your-groq-api-key-here

# Google Gemini API (Primary AI Engine)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
GEMINI_TRANSPORT=rest
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2

# LanguageTool Cloud API / Self-Hosted Endpoint
LANGUAGETOOL_API_KEY=your-languagetool-api-key
LANGUAGETOOL_API_URL=https://api.languagetoolplus.com/v2/check
LANGUAGETOOL_USERNAME=your-languagetool-username
ENABLE_GRAMMAR_CHECK=1

# Classical ML & RAG Engine Configuration (Offline Local Architecture)
# Presenova operates completely offline using scikit-learn, spaCy (en_core_web_sm),
# SentenceTransformers (all-MiniLM-L6-v2), and FAISS vector indices.
NLP_SPACY_MODEL=en_core_web_sm
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_TYPE=FlatIP

# Presentation Rewriter & Generator Offline Flags
FORCE_OFFLINE_MODE=1
PRESENTATION_REWRITER_OFFLINE=1
PRESENTATION_REWRITER_ENABLE_GRAMMAR_CHECK=1
PRESENTATION_REWRITER_MAX_UPLOAD_BYTES=52428800
PRESENTATION_REWRITER_DOWNLOAD_DIR=downloads

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Configuration
HOST=0.0.0.0
PORT=5000
